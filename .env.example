# CourtListener credentials (environment only; never commit real values)
# Prefer COURTLISTENER_API_TOKEN; COURTLISTENER_API_KEY is accepted as a fallback.
COURTLISTENER_API_TOKEN=your_api_token_here
COURTLISTENER_API_KEY=your_api_key_here
COURTLISTENER_EMAIL=your_email@example.com

# Extraction limits
MAX_CASES=1000
MAX_SEARCH_PAGES=10

# Snippet controls
TEXT_SNIPPET_CHARS=12000
SNIPPET_FETCH_MAX=450
SNIPPET_FETCH_SLEEP=0.10